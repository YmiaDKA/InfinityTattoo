{
  "name": "infinity-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply studio --local",
    "db:migrate:remote": "wrangler d1 migrations apply studio --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261012.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.149.0"
  }
}
